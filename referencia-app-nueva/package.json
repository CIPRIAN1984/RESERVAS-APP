{
  "name": "itaca-jiu-jitsu",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "db:start": "supabase start -x vector,logflare,imgproxy,edge-runtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:concurrency": "bash supabase/tests/concurrency.sh",
    "deploy": "vite build --mode production && npx -y wrangler@3 pages deploy dist --project-name itaca-jiu-jitsu --branch main",
    "db:push:production": "SUPABASE_ACCESS_TOKEN=\"${SUPABASE_ACCESS_TOKEN:-$(cat ~/.config/supabase-itaca-token 2>/dev/null)}\" supabase db push --remote --yes",
    "db:setup-production": "echo 'Ver docs/PRODUCCION.md'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.8",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
