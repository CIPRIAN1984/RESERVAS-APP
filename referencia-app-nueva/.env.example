# Copia este fichero a .env.local y rellena los valores.
# En local, `npx supabase status` (o `supabase start`) muestra la URL y la clave pública (anon / publishable).
# Sin estas variables la app funciona en modo demo con datos de ejemplo.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
